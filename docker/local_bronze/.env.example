# Esempio variabili ambiente per docker-compose. Copiare in `.env` (non versionato)
# e modificare se le cartelle dati sono in un path diverso.

# Cartella host con i CSV di landing (output del landing simulator)
DATA_LANDING=C:/PROGETTI/LOGISTICO_DATA/data/landing

# Cartella host dove persistere le Delta tables generate dai Bronze
DATA_WAREHOUSE=C:/PROGETTI/LOGISTICO_DATA/data/warehouse

# Memoria driver Spark (4g default; aumentare se necessario per dataset grandi)
SPARK_DRIVER_MEMORY=4g
